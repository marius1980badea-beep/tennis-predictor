# NEVER commit .env to git (it's in .gitignore)

# ============================================================================
# Supabase Configuration
# ============================================================================
# Get these from: https://supabase.com/dashboard/project/bjjqnqxyfzgkgnkwlgsc/settings/api

SUPABASE_URL=https://bjjqnqxyfzgkgnkwlgsc.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJqanFucXh5Znpna2dua3dsZ3NjIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzk0NDg3ODQsImV4cCI6MjA5NTAyNDc4NH0.B_p4h_vaSi-Y0gkA1ARt3LT0ASuNuiWSwubaScZ2q5I
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Direct PostgreSQL connection (for bulk operations)
# Get DB password from: Settings > Database > Connection string
# Format: postgresql://postgres.PROJECT_REF:DB_PASSWORD@HOST:PORT/postgres
SUPABASE_DB_PASSWORD=your_db_password_here
SUPABASE_DB_HOST=aws-1-eu-central-1.pooler.supabase.com
SUPABASE_DB_PORT=6543
SUPABASE_DB_USER=postgres.bjjqnqxyfzgkgnkwlgsc
SUPABASE_DB_NAME=postgres

# ============================================================================
# Anthropic Configuration (for news intelligence layer - Phase 2)
# ============================================================================
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL_HAIKU=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_SONNET=claude-sonnet-4-6

# ============================================================================
# Data Source Configuration
# ============================================================================
# Sackmann GitHub repos (used for cloning fresh data)
SACKMANN_ATP_REPO=https://github.com/JeffSackmann/tennis_atp.git
SACKMANN_WTA_REPO=https://github.com/JeffSackmann/tennis_wta.git

# Date range for initial data load
